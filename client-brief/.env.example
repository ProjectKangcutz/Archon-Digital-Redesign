# Konfigurasi Aplikasi Client Brief ArchonDigital
# Salin file ini menjadi .env (di luar direktori public_html jika memungkinkan)

APP_NAME="ArchonDigital Client Brief"
APP_ENV=production
APP_URL=https://brief.archondigital.web.id
MAIN_SITE_URL=https://archondigital.web.id/
ARCHON_WHATSAPP=6285159117451

# Koneksi Database MySQL (Gunakan database terpisah khusus Client Brief)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=archon_client_brief
DB_USER=isi_user_database_mysql
DB_PASS=isi_password_database_mysql
DB_CHARSET=utf8mb4

# Keamanan Sesi Admin (dalam detik)
SESSION_NAME=archon_brief_session
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

# Batas Percobaan (Rate Limiting)
BRIEF_RATE_MAX_ATTEMPTS=5
BRIEF_RATE_WINDOW_SECONDS=900
LOGIN_RATE_MAX_ATTEMPTS=5
LOGIN_RATE_WINDOW_SECONDS=900
